generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id            String            @id @default(uuid()) @db.Uuid
  nombre        String
  razonSocial   String            @default("") @map("razon_social")
  ruc           String            @unique
  email         String            @unique @map("correo")
  passwordHash  String            @map("hash_contrasena")
  logo          String?
  telefono      String            @default("")
  paginaWeb     String            @default("") @map("pagina_web")
  rubro         String
  descripcion   String?
  createdAt     DateTime          @default(now()) @map("creado_en")
  updatedAt     DateTime          @updatedAt @map("actualizado_en")
  contactos     ContactoEmpresa[]
  ofertas       OfertaLaboral[]
  sesiones      Sesion[]
  usuarios      Usuario[]

  @@map("empresas")
}

model ContactoEmpresa {
  id              Int     @id @default(autoincrement())
  empresaId       String  @map("empresa_id") @db.Uuid
  empresa         Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nombres         String
  apellidoPaterno String  @map("apellido_paterno")
  correo          String
  celular         String
  esPrincipal     Boolean @default(false) @map("es_principal")
  esGerente       Boolean @default(false) @map("es_gerente")

  @@index([empresaId])
  @@map("contactos_empresa")
}

model Direccion {
  id               String          @id @default(uuid()) @db.Uuid
  direccionLiteral String          @map("direccion_literal")
  latitud          String?
  longitud         String?
  ofertas          OfertaLaboral[]
  postulantes      Postulante[]

  @@map("direcciones")
}

model OfertaLaboral {
  id                 String               @id @default(uuid()) @db.Uuid
  empresaId          String               @map("empresa_id") @db.Uuid
  empresa            Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  direccionTrabajoId String?              @map("direccion_trabajo_id") @db.Uuid
  direccionTrabajo   Direccion?           @relation(fields: [direccionTrabajoId], references: [id])
  titulo             String
  perfil             String               @default("")
  descripcion        String
  tipoContrato       String               @default("Indefinido") @map("tipo_contrato")
  modalidad          String
  salario            String               @default("A convenir")
  estado             String               @default("Activa")
  fechaPublicacion   DateTime             @default(now()) @map("fecha_publicacion")
  logoArchivos       Json                 @default("[]") @map("archivos_logo")
  basesArchivo       Json?                @map("archivo_bases")
  tipoPuesto         Json                 @default("[]") @map("tipos_puesto")
  cantidadVacantes   Int                  @default(1) @map("cantidad_vacantes")
  aptoDiscapacidad   Boolean              @default(false) @map("apto_discapacidad")
  funciones          String
  beneficios         String
  createdAt          DateTime             @default(now()) @map("creado_en")
  updatedAt          DateTime             @updatedAt @map("actualizado_en")
  cronogramas        Cronograma[]
  carreras           OfertaCarrera[]
  conocimientos      OfertaConocimiento[]
  postulaciones      Postulacion[]
  vistas             OfertaVista[]

  @@index([empresaId])
  @@index([estado])
  @@map("ofertas_laborales")
}

model Cronograma {
  id          String        @id @default(uuid()) @db.Uuid
  ofertaId    String        @map("oferta_id") @db.Uuid
  oferta      OfertaLaboral @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  etapa       String
  urlConsulta String        @default("") @map("url_consulta")
  inicio      DateTime
  fin         DateTime?
  responsable String        @default("")

  @@index([ofertaId])
  @@map("cronogramas")
}

model TipoDoc {
  id             Int          @id @default(autoincrement())
  nombreCompleto String       @map("nombre_completo")
  abrev          String       @unique @map("abreviatura")
  postulantes    Postulante[]

  @@map("tipos_documento")
}

model Pais {
  id             Int          @id @default(autoincrement())
  nombre         String
  prefijoCelular String       @map("prefijo_celular")
  postulantes    Postulante[]

  @@map("paises")
}

model CatalogoCarrera {
  id          Int             @id @default(autoincrement())
  nombre      String          @unique
  educaciones Educacion[]
  ofertas     OfertaCarrera[]

  @@map("catalogo_carreras")
}

model CatalogoConocimiento {
  id          Int                      @id @default(autoincrement())
  nombre      String
  grupo       String
  postulantes ConocimientoPostulante[]
  ofertas     OfertaConocimiento[]

  @@unique([nombre, grupo])
  @@map("catalogo_conocimientos")
}

model CatalogoInstitucion {
  id          Int    @id @default(autoincrement())
  razonSocial String @map("razon_social")
  nombre      String

  @@map("catalogo_instituciones")
}

model OfertaCarrera {
  ofertaId  String          @map("oferta_id") @db.Uuid
  carreraId Int             @map("carrera_id")
  oferta    OfertaLaboral   @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  carrera   CatalogoCarrera @relation(fields: [carreraId], references: [id])

  @@id([ofertaId, carreraId])
  @@map("oferta_carreras")
}

model OfertaConocimiento {
  ofertaId       String               @map("oferta_id") @db.Uuid
  conocimientoId Int                  @map("conocimiento_id")
  oferta         OfertaLaboral        @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  conocimiento   CatalogoConocimiento @relation(fields: [conocimientoId], references: [id])

  @@id([ofertaId, conocimientoId])
  @@map("oferta_conocimientos")
}

model Postulante {
  id                String                   @id @default(uuid()) @db.Uuid
  tipoDocId         Int                      @map("tipo_documento_id")
  tipoDoc           TipoDoc                  @relation(fields: [tipoDocId], references: [id])
  numeroDocumento   String                   @map("numero_documento")
  nombres           String
  apellidoPaterno   String                   @map("apellido_paterno")
  apellidoMaterno   String                   @map("apellido_materno")
  fechaNacimiento   DateTime                 @map("fecha_nacimiento") @db.Date
  paisId            Int                      @map("pais_id")
  pais              Pais                     @relation(fields: [paisId], references: [id])
  genero            String
  estadoCivil       String                   @default("Soltero") @map("estado_civil")
  correo            String                   @unique
  passwordHash      String                   @map("hash_contrasena")
  telefono          String
  direccionId       String?                  @map("direccion_id") @db.Uuid
  direccion         Direccion?               @relation(fields: [direccionId], references: [id])
  tieneDiscapacidad Boolean                  @default(false) @map("tiene_discapacidad")
  cvPath            String?                  @map("ruta_cv")
  cvParsed          Json                     @default("{}") @map("cv_analizado")
  createdAt         DateTime                 @default(now()) @map("creado_en")
  updatedAt         DateTime                 @updatedAt @map("actualizado_en")
  experiencias      ExpLaboral[]
  educaciones       Educacion[]
  conocimientos     ConocimientoPostulante[]
  postulaciones     Postulacion[]
  ofertasVistas     OfertaVista[]
  sesiones          Sesion[]
  usuarios          Usuario[]

  @@unique([tipoDocId, numeroDocumento])
  @@map("postulantes")
}

model ExpLaboral {
  id            String     @id @default(uuid()) @db.Uuid
  postulanteId  String     @map("postulante_id") @db.Uuid
  postulante    Postulante @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  sector        String
  empresa       String
  puesto        String
  tiempoMeses   Int        @default(0) @map("tiempo_meses")
  fechaInicio   DateTime   @map("fecha_inicio") @db.Date
  fechaFin      DateTime?  @map("fecha_fin") @db.Date
  documentoPath String?    @map("ruta_documento")

  @@index([postulanteId])
  @@map("experiencias_laborales")
}

model Educacion {
  id            String          @id @default(uuid()) @db.Uuid
  postulanteId  String          @map("postulante_id") @db.Uuid
  postulante    Postulante      @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  carreraId     Int             @map("carrera_id")
  carrera       CatalogoCarrera @relation(fields: [carreraId], references: [id])
  tipoEstudio   String          @map("tipo_estudio")
  institucion   String
  ordenMerito   String          @default("No aplica") @map("orden_merito")
  fechaIngreso  DateTime        @map("fecha_ingreso") @db.Date
  fechaEgreso   DateTime?       @map("fecha_egreso") @db.Date
  documentoPath String?         @map("ruta_documento")

  @@index([postulanteId])
  @@map("educaciones")
}

model ConocimientoPostulante {
  id             String               @id @default(uuid()) @db.Uuid
  postulanteId   String               @map("postulante_id") @db.Uuid
  postulante     Postulante           @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  conocimientoId Int                  @map("conocimiento_id")
  conocimiento   CatalogoConocimiento @relation(fields: [conocimientoId], references: [id])
  institucion    String               @default("")
  documentoPath  String?              @map("ruta_documento")

  @@index([postulanteId])
  @@map("conocimientos_postulante")
}

model Postulacion {
  id                String        @id @default(uuid()) @db.Uuid
  codigo            String        @unique
  ofertaId          String        @map("oferta_id") @db.Uuid
  postulanteId      String        @map("postulante_id") @db.Uuid
  oferta            OfertaLaboral @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  postulante        Postulante    @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  estadoSeguimiento String        @default("En Revisión") @map("estado_seguimiento")
  matchScore        Int           @default(0) @map("puntaje_coincidencia")
  rankingFit        String        @default("Medium") @map("ranking_ajuste")
  cvPath            String?       @map("ruta_cv")
  lastUpdate        DateTime      @default(now()) @map("ultima_actualizacion")
  createdAt         DateTime      @default(now()) @map("creado_en")
  updatedAt         DateTime      @updatedAt @map("actualizado_en")
  historial         HistorialPostulacion[]

  @@unique([ofertaId, postulanteId])
  @@index([ofertaId])
  @@index([postulanteId])
  @@map("postulaciones")
}

model OfertaVista {
  postulanteId String        @map("postulante_id") @db.Uuid
  ofertaId     String        @map("oferta_id") @db.Uuid
  vistoEn      DateTime      @default(now()) @map("visto_en")
  postulante   Postulante    @relation(fields: [postulanteId], references: [id], onDelete: Cascade)
  oferta       OfertaLaboral @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@id([postulanteId, ofertaId])
  @@index([ofertaId])
  @@index([postulanteId])
  @@map("ofertas_vistas")
}

model HistorialPostulacion {
  id             String      @id @default(uuid()) @db.Uuid
  postulacionId  String      @map("postulacion_id") @db.Uuid
  postulacion    Postulacion @relation(fields: [postulacionId], references: [id], onDelete: Cascade)
  estadoAnterior String?     @map("estado_anterior")
  estadoNuevo    String      @map("estado_nuevo")
  accion         String?
  createdAt      DateTime    @default(now()) @map("creado_en")

  @@map("historial_postulaciones")
}

model Usuario {
  id              String       @id @default(uuid()) @db.Uuid
  correo          String       @unique
  passwordHash    String       @map("hash_contrasena")
  nombres         String
  apellidoPaterno String       @default("") @map("apellido_paterno")
  activo          Boolean      @default(true)
  empresaId       String?      @map("empresa_id") @db.Uuid
  postulanteId    String?      @map("postulante_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("creado_en")
  updatedAt       DateTime     @updatedAt @map("actualizado_en")
  empresa         Empresa?     @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  postulante      Postulante?  @relation(fields: [postulanteId], references: [id], onDelete: SetNull)
  rolesAsignados  UsuarioRol[]
  sesiones        Sesion[]

  @@map("usuarios")
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String       @default("")
  usuarios    UsuarioRol[]
  permisos    RolPermiso[]

  @@map("roles")
}

model Permiso {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique
  descripcion String       @default("")
  roles       RolPermiso[]

  @@map("permisos")
}

model UsuarioRol {
  usuarioId String  @map("usuario_id") @db.Uuid
  rolId     Int     @map("rol_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model RolPermiso {
  rolId     Int     @map("rol_id")
  permisoId Int     @map("permiso_id")
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model Sesion {
  id           String      @id @default(uuid()) @db.Uuid
  token        String      @unique
  tipoUsuario  String      @map("tipo_usuario")
  usuarioId    String?     @map("usuario_id") @db.Uuid
  empresaId    String?     @map("empresa_id") @db.Uuid
  postulanteId String?     @map("postulante_id") @db.Uuid
  expiresAt    DateTime    @map("expira_en")
  createdAt    DateTime    @default(now()) @map("creado_en")
  usuario      Usuario?    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa      Empresa?    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  postulante   Postulante? @relation(fields: [postulanteId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("sesiones")
}
